{
  "name": "frontend",
  "private": true,
  "version": "0.2.8",
  "packageManager": "bun@1.3.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "bun test tests",
    "lint": "eslint . && bun run i18n:check",
    "lint:fix": "eslint . --fix",
    "i18n:check": "bun scripts/check-i18n.ts",
    "verify": "bun run lint && bun run test && bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ark-ui/solid": "^5.38.2",
    "@kobalte/core": "^0.13.13",
    "@solid-primitives/clipboard": "^1.6.6",
    "@solid-primitives/i18n": "^2.2.1",
    "@solid-primitives/keyboard": "^1.3.7",
    "@solidjs/router": "^1.0.0",
    "@tabler/icons-solidjs": "^3.46.0",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18n": "^2.4.0",
    "eslint-plugin-solid": "^0.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": [
      "prettier --write"
    ]
  }
}
